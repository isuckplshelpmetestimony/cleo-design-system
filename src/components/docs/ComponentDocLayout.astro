---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import TagPills from './TagPills.astro';
import CopyPath from './CopyPath.astro';
import RelatedLinks from './RelatedLinks.astro';
import type { MvpTag } from '../../config/registry';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  pageTitle?: string;
  breadcrumbs?: Crumb[];
  mvp?: MvpTag;
  device?: string;
  copyPath?: string;
  entryId?: string;
  withPreview?: boolean;
  /** Stack context preview above isolated block preview. */
  stackedPreview?: boolean;
  /** @deprecated Use stackedPreview */
  withVisitContext?: boolean;
  previewContextLabel?: string;
  previewBlockLabel?: string;
}

const {
  title,
  description,
  pageTitle = title,
  breadcrumbs = [],
  mvp = 'core',
  device,
  copyPath,
  entryId,
  withPreview = false,
  stackedPreview: stackedPreviewProp,
  withVisitContext = false,
  previewContextLabel: previewContextLabelProp,
  previewBlockLabel = 'This block',
} = Astro.props;

const stackedPreview = stackedPreviewProp ?? withVisitContext;
const previewContextLabel =
  previewContextLabelProp ?? (withVisitContext ? 'In visit shell' : 'Context');
---

<DocsLayout title={pageTitle} description={description}>
  {breadcrumbs.length > 0 && <Breadcrumbs crumbs={breadcrumbs} />}

  {
    withPreview ? (
      <div class="doc-with-preview">
        <div class="doc-main">
          <div class="prose">
            <h1>{title}</h1>
            <p class="page-lead">{description}</p>
            <TagPills mvp={mvp} device={device} />
            <slot name="whenToUse" />
            <slot name="anatomy" />
            <slot name="doDont" />
            {copyPath && <CopyPath path={copyPath} />}
            <slot name="specs" />
          </div>
        </div>
        <div class="doc-preview preview-sticky">
          <div class="preview-header">
            <span class="preview-title">Preview</span>
          </div>
          <div class:list={['preview-stack', { 'preview-stack--dual': stackedPreview }]}>
            {
              stackedPreview && (
                <>
                  <p class="preview-sublabel">{previewContextLabel}</p>
                  <div class="preview-panel preview-panel--context">
                    <slot name="contextPreview" />
                  </div>
                  <p class="preview-sublabel">{previewBlockLabel}</p>
                </>
              )
            }
            <div class="preview-panel preview-panel--block">
              <slot name="preview" />
            </div>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="prose">
          <h1>{title}</h1>
          <p class="page-lead">{description}</p>
          <TagPills mvp={mvp} device={device} />
          <slot name="whenToUse" />
          <slot name="anatomy" />
        </div>
        <slot name="preview" />
        <div class="prose">
          <slot name="doDont" />
          {copyPath && <CopyPath path={copyPath} />}
          <slot name="specs" />
        </div>
      </>
    )
  }

  <slot name="registry" />
  <RelatedLinks entryId={entryId} />
</DocsLayout>

<style>
  .doc-with-preview {
    display: grid;
    grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    width: 100%;
    max-width: none;
  }

  .doc-with-preview .prose {
    max-width: none;
  }

  .preview-sticky {
    position: sticky;
    top: var(--space-8);
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .preview-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-midnight);
  }

  .preview-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .preview-sublabel {
    margin: 0 0 var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .preview-stack--dual .preview-sublabel + .preview-panel--context {
    margin-bottom: var(--space-4);
  }

  .preview-stack--dual .preview-sublabel:nth-of-type(2) {
    margin-top: var(--space-2);
  }

  .preview-panel {
    background: var(--surface-preview, var(--color-fog));
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    width: 100%;
    overflow-x: auto;
  }

  .preview-panel--context {
    min-height: 280px;
    max-height: min(70vh, 824px);
    overflow-y: auto;
  }

  .preview-panel--block {
    min-height: 120px;
  }

  .preview-stack:not(.preview-stack--dual) .preview-panel--block {
    min-height: 200px;
  }

  .preview-panel :global(.visit-shell-frame) {
    width: 100%;
    min-width: min(100%, 720px);
  }

  @media (max-width: 900px) {
    .doc-with-preview {
      grid-template-columns: 1fr;
    }

    .preview-sticky {
      position: static;
    }
  }
</style>
