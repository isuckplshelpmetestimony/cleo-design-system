---
import { navSections, quietAuthoritySwatches, isActive } from '../../config/nav';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<aside class="sidebar" transition:persist="cleo-sidebar" transition:animate="none">
  <div class="sidebar-brand">
    <a href="/" class="brand-link">Cleo</a>
    <p class="brand-sub">Design System</p>
  </div>

  <nav class="sidebar-nav" aria-label="Design system">
    {
      navSections.map((section) => (
        <div class="nav-section">
          <h2 class="nav-section-title">{section.title}</h2>
          <ul class="nav-list">
            {section.items.map((item) => {
              const active = isActive(item.href, currentPath);
              return (
                <li>
                  <a href={item.href} class:list={['nav-link', { active }]}>
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="sidebar-swatches" aria-label="Quiet Authority palette">
    <p class="swatches-label">Quiet Authority</p>
    <div class="swatch-row">
      {
        quietAuthoritySwatches.map((s) => (
          <div class="swatch-item" title={`${s.name} ${s.hex}`}>
            <span class="swatch-chip" style={`background: ${s.hex}`} />
            <span class="swatch-name">{s.name}</span>
            <span class="swatch-hex">{s.hex}</span>
          </div>
        ))
      }
    </div>
  </div>
</aside>

<script>
  const SIDEBAR_SCROLL_KEY = 'cleo-sidebar-scroll';

  function getSidebar() {
    return document.querySelector('.sidebar');
  }

  function saveSidebarScroll() {
    const el = getSidebar();
    if (el) sessionStorage.setItem(SIDEBAR_SCROLL_KEY, String(el.scrollTop));
  }

  function restoreSidebarScroll() {
    const el = getSidebar();
    if (!el) return;
    const saved = sessionStorage.getItem(SIDEBAR_SCROLL_KEY);
    if (saved != null) el.scrollTop = Number(saved);
  }

  function updateSidebarActive() {
    const path = window.location.pathname;
    document.querySelectorAll('.sidebar .nav-link').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;
      const active =
        href === '/' ? path === '/' || path === '/index.html' : path === href || path.startsWith(`${href}/`);
      link.classList.toggle('active', active);
    });
  }

  function initSidebar() {
    updateSidebarActive();
    restoreSidebarScroll();
    const el = getSidebar();
    if (el && !el.dataset.scrollBound) {
      el.dataset.scrollBound = 'true';
      el.addEventListener('scroll', saveSidebarScroll, { passive: true });
    }
  }

  initSidebar();
  document.addEventListener('astro:before-swap', saveSidebarScroll);
  document.addEventListener('astro:after-swap', restoreSidebarScroll);
  document.addEventListener('astro:page-load', initSidebar);
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: var(--color-surface-sidebar);
    padding: var(--space-8) var(--space-6);
    overflow-y: auto;
    overflow-anchor: none;
    z-index: 100;
    display: flex;
    flex-direction: column;
  }

  .sidebar-brand {
    margin-bottom: var(--space-8);
  }

  .brand-link {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-midnight);
    text-decoration: none;
  }

  .brand-sub {
    margin: var(--space-2) 0 0;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-steel);
  }

  .sidebar-nav {
    flex: 1;
  }

  .nav-section {
    margin-bottom: var(--space-6);
  }

  .nav-section-title {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-steel);
    margin: 0 0 var(--space-2);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list li {
    margin: 0;
  }

  .nav-link {
    display: block;
    padding: var(--space-1) var(--space-4);
    margin-left: calc(-1 * var(--space-4));
    color: var(--color-slate);
    font-size: 0.875rem;
    border-left: 2px solid transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-midnight);
  }

  .nav-link.active {
    color: var(--color-midnight);
    border-left-color: var(--color-amber);
  }

  .sidebar-swatches {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: var(--border-hairline);
  }

  .swatches-label {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-steel);
    margin: 0 0 var(--space-3);
  }

  .swatch-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .swatch-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .swatch-chip {
    display: block;
    width: 100%;
    height: 14px;
    border-radius: 3px;
    border: var(--border-hairline);
  }

  .swatch-name {
    font-size: 0.625rem;
    color: var(--color-midnight);
    font-weight: var(--weight-medium);
  }

  .swatch-hex {
    font-size: 0.5625rem;
    color: var(--color-steel);
    font-family: var(--font-sans);
  }

</style>
