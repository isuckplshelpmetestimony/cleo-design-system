---
import type { MvpTag } from '../../config/registry';

interface Props {
  mvp?: MvpTag;
  showMvp?: boolean;
  device?: string;
}

const { mvp = 'core', showMvp = true, device } = Astro.props;
---

<div class="tag-pills">
  {showMvp && <span class="pill pill-mvp">{mvp}</span>}
  {mvp === 'core' && <span class="pill pill-core">MVP</span>}
  {device && <span class="pill pill-device">{device}</span>}
</div>

<style>
  .tag-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .pill {
    display: inline-block;
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    border: var(--border-hairline);
    color: var(--color-slate);
    background: var(--color-surface-elevated);
  }

  .pill-core {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
</style>
