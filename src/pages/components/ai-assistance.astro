---
import PatternDocLayout from '../../components/docs/PatternDocLayout.astro';
import PhilosophyCallout from '../../components/docs/PhilosophyCallout.astro';
import RegistryTable from '../../components/docs/RegistryTable.astro';
import AiAssistanceShowcase from '../../components/cleo/patterns/AiAssistanceShowcase';
---

<PatternDocLayout
  title="AI assistance behavior"
  description='Never say "AI-powered." Show the work. Let the therapist remain the author.'
  breadcrumbs={[
    { label: 'Registry', href: '/registry' },
    { label: 'Components', href: '/registry' },
    { label: 'AI assistance' },
  ]}
  mvp="core"
  device="iPad landscape"
  copyPath="src/components/cleo/patterns/AiAssistanceShowcase.tsx"
  entryId="ai-assistance"
  withVisitContext={true}
  previewContextLabel="In visit shell"
  previewBlockLabel="This pattern"
>
  <Fragment slot="whenToUse">
    <h2>Behavior</h2>
    <ul>
      <li>Suggestions appear inline, not in chat bubbles</li>
      <li>Edits are always reviewable before sign — Frame 5 trust requirement</li>
      <li>No anthropomorphic assistant persona</li>
      <li>Progress during transcription is soft and linear — no chatty status messages</li>
    </ul>

    <h2>Copy</h2>
    <p>We say: "Suggested revision below." We never say: "Cleo AI optimized your note."</p>

    <PhilosophyCallout>
      <p>The senior clinician colleague does not boast about tools. Neither does Cleo.</p>
    </PhilosophyCallout>
  </Fragment>

  <Fragment slot="preview">
    <AiAssistanceShowcase client:load />
  </Fragment>

  <Fragment slot="registry">
    <RegistryTable title="Related registry" filterIds={['ai-assistance', 'visit-shell', 'record-in-note']} />
  </Fragment>
</PatternDocLayout>
