---
import ComponentDocLayout from '../../components/docs/ComponentDocLayout.astro';
import PhilosophyCallout from '../../components/docs/PhilosophyCallout.astro';
import ButtonShowcase from '../../components/cleo/ButtonShowcase.astro';
---

<ComponentDocLayout
  title="Buttons"
  description="Slate reads as calm authority. Cream reads as warmth. Together: I know what I'm doing and I care about you."
  breadcrumbs={[
    { label: 'Registry', href: '/registry' },
    { label: 'Components', href: '/registry' },
    { label: 'Buttons' },
  ]}
  mvp="core"
  copyPath="src/components/cleo/Button.tsx"
  entryId="buttons"
>
  <Fragment slot="preview">
    <div class="wide-band">
      <ButtonShowcase />
    </div>
  </Fragment>

  <Fragment slot="specs">
    <h2>Specifications</h2>
    <table class="token-table">
      <tbody>
        <tr>
          <td><strong>Primary</strong></td>
          <td>Slate background (<code>#2E4057</code>), cream text. Default important action.</td>
        </tr>
        <tr>
          <td><strong>Amber CTA</strong></td>
          <td>Amber background, cream text. Once per screen max.</td>
        </tr>
        <tr>
          <td><strong>Ghost</strong></td>
          <td>Transparent, hairline slate border. Secondary actions.</td>
        </tr>
        <tr>
          <td><strong>Disabled</strong></td>
          <td>45% opacity, no hover.</td>
        </tr>
      </tbody>
    </table>

    <h2>Shared specs</h2>
    <ul>
      <li>DM Sans 500, 17px · padding 10×24px · radius 8px</li>
      <li>Press: scale(0.98), 150ms</li>
    </ul>

    <PhilosophyCallout>
      <p>Secondary actions step back so the interface never competes with the therapist's attention.</p>
    </PhilosophyCallout>
  </Fragment>
</ComponentDocLayout>
